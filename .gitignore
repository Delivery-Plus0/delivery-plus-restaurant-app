# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files — never commit real values; document variables in .env.example instead
.env
.env.*
!.env.example

# test / tooling output
coverage/
*.log
Thumbs.db

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# E2E build output, Maestro reports and screenshots
e2e/.web-build/
e2e/.driver-web-build/
e2e/.artifacts/
